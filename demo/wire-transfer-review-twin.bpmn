<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  id="Definitions_WireTransferReview"
                  targetNamespace="http://metaml.com/bpmn">
  <bpmn:process id="wireTransferReview" name="Wire Transfer Review" isExecutable="true">

    <bpmn:startEvent id="StartEvent_RequestReceived" name="Transfer Request Received">
      <bpmn:outgoing>Flow_ToKyc</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="Task_KYC" name="Verify Customer Identity (KYC)">
      <bpmn:incoming>Flow_ToKyc</bpmn:incoming>
      <bpmn:outgoing>Flow_ToIdentityGateway</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Flow_IdentityNo is the gateway's default: Camunda rejects a deployment where a
         non-default outgoing flow of an exclusive gateway has no condition. -->
    <bpmn:exclusiveGateway id="Gateway_IdentityVerified" name="Identity verified?" default="Flow_IdentityNo">
      <bpmn:incoming>Flow_ToIdentityGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_IdentityYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_IdentityNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_RejectIdentity" name="Reject: Identity Not Verified">
      <bpmn:incoming>Flow_IdentityNo</bpmn:incoming>
      <bpmn:outgoing>Flow_ToRejected</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_OFAC" name="Screen Against Sanctions List (OFAC)">
      <bpmn:incoming>Flow_IdentityYes</bpmn:incoming>
      <bpmn:outgoing>Flow_ToApprove</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_ApproveAmount" name="Approve Transfer Amount">
      <bpmn:incoming>Flow_ToApprove</bpmn:incoming>
      <bpmn:outgoing>Flow_ToExecute</bpmn:outgoing>
    </bpmn:userTask>

    <!-- User task, not a serviceTask: TwinModelGenerator rejects a serviceTask outright, so the
         twin/Evolve half of the demo uses this variant. The Generate/Launch half uses the
         serviceTask version in wire-transfer-review.bpmn. -->
    <bpmn:userTask id="Task_ExecuteTransfer" name="Execute Wire Transfer">
      <bpmn:incoming>Flow_ToExecute</bpmn:incoming>
      <bpmn:outgoing>Flow_ToNotify</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_NotifyCustomer" name="Notify Customer of Completion">
      <bpmn:incoming>Flow_ToNotify</bpmn:incoming>
      <bpmn:outgoing>Flow_ToCompleted</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="EndEvent_Completed" name="Transfer Completed">
      <bpmn:incoming>Flow_ToCompleted</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_Rejected" name="Transfer Rejected">
      <bpmn:incoming>Flow_ToRejected</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_ToKyc" sourceRef="StartEvent_RequestReceived" targetRef="Task_KYC" />
    <bpmn:sequenceFlow id="Flow_ToIdentityGateway" sourceRef="Task_KYC" targetRef="Gateway_IdentityVerified" />
    <bpmn:sequenceFlow id="Flow_IdentityYes" name="Yes" sourceRef="Gateway_IdentityVerified" targetRef="Task_OFAC">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"
                                xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">${identityVerified}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_IdentityNo" name="No" sourceRef="Gateway_IdentityVerified" targetRef="Task_RejectIdentity" />
    <bpmn:sequenceFlow id="Flow_ToApprove" sourceRef="Task_OFAC" targetRef="Task_ApproveAmount" />
    <bpmn:sequenceFlow id="Flow_ToExecute" sourceRef="Task_ApproveAmount" targetRef="Task_ExecuteTransfer" />
    <bpmn:sequenceFlow id="Flow_ToNotify" sourceRef="Task_ExecuteTransfer" targetRef="Task_NotifyCustomer" />
    <bpmn:sequenceFlow id="Flow_ToCompleted" sourceRef="Task_NotifyCustomer" targetRef="EndEvent_Completed" />
    <bpmn:sequenceFlow id="Flow_ToRejected" sourceRef="Task_RejectIdentity" targetRef="EndEvent_Rejected" />

  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="wireTransferReview">
      <bpmndi:BPMNShape id="StartEvent_RequestReceived_di" bpmnElement="StartEvent_RequestReceived">
        <dc:Bounds x="152" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="132" y="225" width="80" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_KYC_di" bpmnElement="Task_KYC">
        <dc:Bounds x="240" y="160" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_IdentityVerified_di" bpmnElement="Gateway_IdentityVerified" isMarkerVisible="true">
        <dc:Bounds x="415" y="175" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="400" y="132" width="80" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RejectIdentity_di" bpmnElement="Task_RejectIdentity">
        <dc:Bounds x="390" y="300" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_OFAC_di" bpmnElement="Task_OFAC">
        <dc:Bounds x="520" y="160" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ApproveAmount_di" bpmnElement="Task_ApproveAmount">
        <dc:Bounds x="690" y="160" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ExecuteTransfer_di" bpmnElement="Task_ExecuteTransfer">
        <dc:Bounds x="860" y="160" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_NotifyCustomer_di" bpmnElement="Task_NotifyCustomer">
        <dc:Bounds x="1030" y="160" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Completed_di" bpmnElement="EndEvent_Completed">
        <dc:Bounds x="1202" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1182" y="225" width="80" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Rejected_di" bpmnElement="EndEvent_Rejected">
        <dc:Bounds x="562" y="322" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="542" y="365" width="80" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_ToKyc_di" bpmnElement="Flow_ToKyc">
        <di:waypoint x="188" y="200" />
        <di:waypoint x="240" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToIdentityGateway_di" bpmnElement="Flow_ToIdentityGateway">
        <di:waypoint x="360" y="200" />
        <di:waypoint x="415" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_IdentityYes_di" bpmnElement="Flow_IdentityYes">
        <di:waypoint x="465" y="200" />
        <di:waypoint x="520" y="200" />
        <bpmndi:BPMNLabel><dc:Bounds x="480" y="182" width="20" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_IdentityNo_di" bpmnElement="Flow_IdentityNo">
        <di:waypoint x="440" y="225" />
        <di:waypoint x="440" y="300" />
        <bpmndi:BPMNLabel><dc:Bounds x="448" y="255" width="20" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToApprove_di" bpmnElement="Flow_ToApprove">
        <di:waypoint x="640" y="200" />
        <di:waypoint x="690" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToExecute_di" bpmnElement="Flow_ToExecute">
        <di:waypoint x="810" y="200" />
        <di:waypoint x="860" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToNotify_di" bpmnElement="Flow_ToNotify">
        <di:waypoint x="980" y="200" />
        <di:waypoint x="1030" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToCompleted_di" bpmnElement="Flow_ToCompleted">
        <di:waypoint x="1150" y="200" />
        <di:waypoint x="1202" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToRejected_di" bpmnElement="Flow_ToRejected">
        <di:waypoint x="510" y="340" />
        <di:waypoint x="562" y="340" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
