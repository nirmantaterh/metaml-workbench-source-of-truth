# Node
node_modules/
frontend/build/

# Java / Gradle / Maven
backend/.gradle/
backend/**/build/
backend/**/target/
.mvn/wrapper/maven-wrapper.jar

# Maven build output from a launched/rebuilt generated Target Platform (the source under
# generated-target-platforms/ is committed; its build output is not)
generated-target-platforms/**/target/

# local h2 file for the camunda engine, whichever directory the app got launched from
backend/data/
backend/**/data/

# runtime logs written by spring-boot:run, local output only
*.log

# Word's lock files, left behind whenever a .md in here gets opened in Office
~$*

# IDE / OS
.idea/
.vscode/
.claude/
*.iml
.DS_Store
Thumbs.db

# AI coding-assistant session transcripts - local working history, not project documentation
.claude-code-history/
.codex-history/

# ad-hoc verification/exploration scripts, not part of the shipped product
scratch/

# Old nested repos, kept as backup only
backend/.git.bak/
frontend/.git.bak/
